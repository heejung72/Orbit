PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:8081
GUEST_SESSION_MINUTES=30
GUEST_WARNING_MINUTES=5
# 만료 Guest 정리 주기 (기본 30초, 테스트할 때 줄이면 test:guest-expiry가 빨리 끝남)
GUEST_CLEANUP_INTERVAL_MS=30000
GUEST_NUDGE_MESSAGE_COUNT=20
