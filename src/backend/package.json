{
  "name": "orbit-backend",
  "version": "1.0.0",
  "description": "Orbit - 취향 기반 익명 소셜 채팅·커뮤니티 백엔드",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrations/run.js",
    "db:reset": "node migrations/reset.js",
    "seed": "node seeds/run.js",
    "db:setup": "npm run db:reset && npm run migrate && npm run seed",
    "test:guest": "node tests/guest.e2e.js",
    "test:auth": "node tests/auth.e2e.js",
    "test:tastes": "node tests/tastes.e2e.js",
    "test:home": "node tests/home.e2e.js",
    "test:chat": "node tests/chat.e2e.js",
    "test:lounges": "node tests/lounges.e2e.js",
    "test:guest-expiry": "node tests/guestExpiry.e2e.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.7.2"
  }
